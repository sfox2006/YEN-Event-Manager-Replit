{
  "name": "yen-event-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc --noEmit && vite build && node server/build-sw.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "replit:dev": "npm ci --include=dev && npm run dev"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "idb": "8.0.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.2",
    "typescript": "5.9.2",
    "vite": "6.3.6",
    "vitest": "3.2.4"
  }
}
